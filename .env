# Application Information
SPRING_APPLICATION_NAME=uniqueAproovaResidency

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/aproova_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=7846
DATABASE_DRIVER=org.postgresql.Driver

# JPA / Hibernate Configuration
# none: Do not touch existing tables (tables are managed manually in PostgreSQL)
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true

# Flyway Database Migrations
# false: Disable automatic Flyway migrations (tables already created in PostgreSQL)
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_LOCATIONS=classpath:db/migration

# OpenAPI / Swagger Documentation
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html

# JWT Security Credentials
JWT_SECRET=9a4f2c8d7b1e3f5a6b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

FILE_STORAGE_PATH=./uploads
PAYMENT_PROVIDER=phonepay@pg.scyl
UPI_MERCHANT_VPA=aproovaresidency@ybl
UPI_MERCHANT_NAME=Aproova Residency Society
